#!/usr/bin/python3
"""Print a Grok usage record for the Omarchy agents panel.

Grok's local unified log records per-inference token counts and the billing
status that the CLI fetched for the signed-in account. Reading that file keeps
this collector offline and avoids storing or handling the Grok session token.
"""

from collections import defaultdict
from datetime import datetime, timedelta, timezone
import json
from pathlib import Path


AGENT_ID = "grok"
AGENT_NAME = "Grok"
LOG_PATH = Path.home() / ".grok" / "logs" / "unified.jsonl"


def number(value):
    try:
        return max(0, int(value or 0))
    except (TypeError, ValueError):
        return 0


def local_datetime(raw):
    try:
        text = str(raw or "")
        if text.endswith("Z"):
            text = text[:-1] + "+00:00"
        parsed = datetime.fromisoformat(text)
        if parsed.tzinfo is None:
            parsed = parsed.replace(tzinfo=timezone.utc)
        return parsed.astimezone()
    except (TypeError, ValueError, OverflowError):
        return None


now = datetime.now().astimezone()
today = now.strftime("%Y-%m-%d")
recent_dates = [(now - timedelta(days=offset)).strftime("%Y-%m-%d") for offset in range(6, -1, -1)]
recent = {day: {"date": day, "messageCount": 0} for day in recent_dates}

today_prompts = 0
today_total_tokens = 0
today_tokens_by_model = defaultdict(int)
today_sessions = set()
total_prompts = 0
total_sessions = set()
active_days = set()
model_usage = {}
session_models = {}
latest_billing = None


def add_usage(day, session_id, model, input_tokens, output_tokens, cache_read, reasoning_tokens):
    global today_prompts, today_total_tokens, total_prompts

    total = input_tokens + output_tokens + cache_read + reasoning_tokens
    if total <= 0:
        return

    total_prompts += 1
    total_sessions.add(session_id)
    active_days.add(day)
    bucket = model_usage.setdefault(model, {
        "inputTokens": 0,
        "outputTokens": 0,
        "cacheReadInputTokens": 0,
        "cacheCreationInputTokens": 0,
    })
    bucket["inputTokens"] += input_tokens
    bucket["outputTokens"] += output_tokens + reasoning_tokens
    bucket["cacheReadInputTokens"] += cache_read

    if day in recent:
        recent[day]["messageCount"] += total
    if day == today:
        today_prompts += 1
        today_sessions.add(session_id)
        today_total_tokens += total
        today_tokens_by_model[model] += total


def read_log():
    global latest_billing
    if not LOG_PATH.is_file():
        return

    try:
        handle = LOG_PATH.open(encoding="utf-8", errors="replace")
    except OSError:
        return

    with handle:
        for raw in handle:
            try:
                event = json.loads(raw)
            except json.JSONDecodeError:
                continue

            message = str(event.get("msg") or "")
            context = event.get("ctx") or {}
            session_id = str(event.get("sid") or "")
            stamp = local_datetime(event.get("ts"))

            if message == "model changed" and session_id:
                model = str(context.get("model") or "")
                if model:
                    session_models[session_id] = model
                continue

            if message == "billing: fetched credits config":
                config = context.get("config") or {}
                period = config.get("currentPeriod") or {}
                candidate = {
                    "percent": number(config.get("creditUsagePercent")),
                    "resetsAt": str(period.get("end") or config.get("billingPeriodEnd") or ""),
                    "tier": str(context.get("subscriptionTier") or ""),
                    "timestamp": event.get("ts") or "",
                }
                if latest_billing is None or str(candidate["timestamp"]) >= str(latest_billing["timestamp"]):
                    latest_billing = candidate
                continue

            if message != "shell.turn.inference_done":
                continue

            prompt_tokens = number(context.get("prompt_tokens"))
            cached_prompt_tokens = min(prompt_tokens, number(context.get("cached_prompt_tokens")))
            completion_tokens = number(context.get("completion_tokens"))
            reasoning_tokens = number(context.get("reasoning_tokens"))
            if not (prompt_tokens or completion_tokens or reasoning_tokens):
                continue

            day = stamp.strftime("%Y-%m-%d") if stamp else today
            model = str(context.get("model") or session_models.get(session_id) or "grok-4.6")
            # Prompt tokens include the cached subset. Keep the split without
            # counting cached prompt tokens twice; reasoning remains visible
            # in the panel's output total.
            add_usage(
                day,
                session_id or "grok",
                model,
                prompt_tokens - cached_prompt_tokens,
                completion_tokens,
                cached_prompt_tokens,
                reasoning_tokens,
            )


read_log()

limits = []
tier = ""
usage_status = ""
auth_help = ""
if latest_billing is not None:
    limits.append({
        "label": "Weekly (7-day)",
        "percent": min(1.0, latest_billing["percent"] / 100.0),
        "resetsAt": latest_billing["resetsAt"],
    })
    tier = latest_billing["tier"]
else:
    usage_status = "Grok limits unavailable"
    auth_help = "Open `grok` once to refresh its local billing status."

record = {
    "schemaVersion": 1,
    "id": AGENT_ID,
    "name": AGENT_NAME,
    "updatedAt": datetime.now(timezone.utc).isoformat(),
    "ready": LOG_PATH.is_file(),
    "hasLocalStats": True,
    "todayPrompts": today_prompts,
    "todaySessions": len(today_sessions),
    "todayTotalTokens": today_total_tokens,
    "todayTokensByModel": dict(today_tokens_by_model),
    "recentDays": [recent[day] for day in recent_dates],
    "totalPrompts": total_prompts,
    "totalSessions": len(total_sessions),
    "activeDays": len(active_days),
    "activeDates": sorted(active_days),
    "modelUsage": model_usage,
    "limits": limits,
    "tierLabel": tier,
    "usageStatusText": usage_status,
    "authHelpText": auth_help,
}

print(json.dumps(record, separators=(",", ":")))
